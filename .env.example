# Source Obsidian vault for `npm run import:data` (READ-ONLY).
#
# Copy this file to `.env` (git-ignored) and set your machine's vault location.
# Use forward slashes; Windows drive paths work as `C:/path/to/vault`.
#
# This is only needed to regenerate the snapshot from a real vault. A clean
# checkout builds without it: `node scripts/ensure-snapshot.mjs` seeds the
# git-ignored snapshot from the committed demonstration fixture.
TVB_SOURCE_VAULT=
